# Do NOT commit your real .env with secrets.
# Do NOT paste real API keys into this file; keep this file as documentation only.

# Resend (email)
RESEND_API_KEY=

# Cloudflare Turnstile (junk removal)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# AWS S3 uploads (optional, for junk-removal photos)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: custom endpoint (leave blank for AWS)
S3_ENDPOINT=

# Optional: pre-signed URL expiry in seconds (default 604800 = 7 days; max 7 days)
S3_PRESIGNED_URL_EXPIRES_SECONDS=604800
